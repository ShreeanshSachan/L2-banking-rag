# Copy to `.env` and fill in real values. `docker compose` reads `.env` automatically.

# --- Google Gemini (required for LLM answers + embeddings) -------------------
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_CHAT_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- JWT ---------------------------------------------------------------------
# MUST be at least 32 characters (HS256). Generate e.g. with:
#   openssl rand -base64 48
JWT_SECRET=dev-only-change-me-super-secret-key-please-override-in-prod-0123456789

# --- Database ----------------------------------------------------------------
DB_USER=bankuser
DB_PASS=bankpass
DB_ROOT_PASS=rootpass

# --- CORS --------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost

# --- Demo data seeding -------------------------------------------------------
# Idempotent. Set SEED_ENABLED=false for an empty DB, or SEED_DUMMY_CUSTOMERS=0
# to seed only alice/admin.
SEED_ENABLED=true
SEED_DUMMY_CUSTOMERS=12
